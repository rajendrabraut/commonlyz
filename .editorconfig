root = true

[*]
charset = utf-8
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_size = 4
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true

[*.{json,yml,yaml,ts,tsx,css,html,props,csproj,slnx}]
indent_size = 2

# EF Core migrations are generated code.
[**/Migrations/*.cs]
generated_code = true
