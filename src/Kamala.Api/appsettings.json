{
  "Files": {
    "Api": {
      // The MVC site's origin(s). Same-origin deployments (e.g. IIS sub-application) need nothing here.
      "AllowedOrigins": [],
      "RequestsPerMinute": 30
    },
    "Limits": {
      "MaxFiles": 20,
      "MaxFileBytes": 52428800,
      "MaxTotalBytes": 209715200,
      "MaxPixels": 50000000,
      "MaxPdfPages": 300,
      "MaxUpscalePixels": 4000000
    },
    "Storage": {
      "Retention": "00:30:00"
    },
    "Engines": {
      // Set these to the installed engines (see README "Kamala").
      "ImgcorePath": "",
      "PythonPath": "",
      "DocEngineDirectory": "",
      "UpscaleModelPath": "",
      "SofficePath": "",
      "Timeout": "00:02:00",
      "OfficeTimeout": "00:03:00"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
