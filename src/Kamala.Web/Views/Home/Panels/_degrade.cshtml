<label>Resolution <output data-for="percent">50</output>%
    <input type="range" data-opt="percent" min="5" max="100" step="5" value="50" />
</label>
<label>JPG quality <output data-for="quality">40</output>
    <input type="range" data-opt="quality" min="1" max="100" step="1" value="40" />
</label>
<label>Blur <output data-for="blur">0</output>
    <input type="range" data-opt="blur" min="0" max="10" step="0.5" value="0" />
</label>
<label class="check"><input type="checkbox" data-opt="grayscale" /> Black &amp; white</label>
