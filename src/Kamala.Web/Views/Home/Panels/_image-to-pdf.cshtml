<label>Page size
    <select data-opt="pageSize">
        <option value="fit" selected>Same as image</option>
        <option value="a4">A4</option>
        <option value="letter">US Letter</option>
    </select>
</label>
<label>Margin
    <select data-opt="marginPoints">
        <option value="0" selected>None</option>
        <option value="18">Small</option>
        <option value="36">Big</option>
    </select>
</label>
<label class="check"><input type="checkbox" data-opt="mergeIntoOne" checked /> Merge all images into one PDF</label>
