<div class="row">
    <label>Format
        <select data-opt="format">
            <option value="same" selected>Same as input</option>
            <option value="jpeg">JPG</option>
            <option value="png">PNG</option>
            <option value="webp">WebP</option>
        </select>
    </label>
    <label>Quality <output data-for="quality">90</output>
        <input type="range" data-opt="quality" min="10" max="100" step="5" value="90" />
    </label>
</div>
