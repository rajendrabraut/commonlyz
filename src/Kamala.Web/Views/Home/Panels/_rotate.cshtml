<label>Rotate
    <select data-opt="degrees">
        <option value="0">Don't rotate</option>
        <option value="90" selected>90° clockwise</option>
        <option value="180">180°</option>
        <option value="270">90° counter-clockwise</option>
    </select>
</label>
<label class="check"><input type="checkbox" data-opt="flipH" /> Mirror horizontally</label>
<label class="check"><input type="checkbox" data-opt="flipV" /> Flip vertically</label>
<partial name="Panels/_format" />
