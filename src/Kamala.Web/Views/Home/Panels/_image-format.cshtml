<label>Convert to
    <select data-opt="to">
        <option value="jpeg" selected>JPG</option>
        <option value="png">PNG</option>
        <option value="webp">WebP (lossless)</option>
    </select>
</label>
<label>Quality <small>(JPG)</small> <output data-for="quality">90</output>
    <input type="range" data-opt="quality" min="10" max="100" step="5" value="90" />
</label>
