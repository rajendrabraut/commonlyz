@{
    ViewData["Title"] = "Privacy";
}
<section class="narrow-page">
    <h1>Privacy &amp; security</h1>
    <ul>
        <li>Your files are processed on this server only. They are never sent to third parties.</li>
        <li>Uploads are deleted as soon as the results are ready; results are deleted after 30 minutes.</li>
        <li>Download links use unguessable random ids; there is no listing of files.</li>
        <li>Image metadata such as GPS location and camera details is removed from edited images.</li>
        <li>Word documents are opened with macros disabled and without fetching linked content.</li>
        <li>No accounts, no cookies for tracking, no analytics.</li>
    </ul>
</section>
