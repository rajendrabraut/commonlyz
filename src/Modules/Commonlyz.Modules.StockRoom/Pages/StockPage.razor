@page "/stockroom"
@inherits ModulePage
@inject StockRoomService Stock
@inject ICurrentUser CurrentUser

<PageHeader Title="StockRoom" Subtitle="Every count is the sum of a movement history — nothing is ever overwritten.">
    <a class="btn" href="stockroom/locations">Locations</a>
</PageHeader>
<Alerts Error="@Error" Success="@Success" />

@if (_locations.Count == 0)
{
    <div class="alert warning"><Icon Name="alert" /> Add a <a href="stockroom/locations">location</a> (e.g. "Workshop shelf A") before recording stock.</div>
}

<div class="with-aside">
    <section class="card">
        <div class="row between">
            <h2>Items</h2>
            <input type="search" style="max-width:240px" placeholder="Search SKU or name" @bind="_search" @bind:event="oninput" @bind:after="LoadAsync" />
        </div>
        @if (_stock.Count == 0)
        {
            <EmptyState Message="No items yet." IconName="box" />
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead><tr><th>SKU</th><th>Item</th><th>Where</th><th class="num">On hand</th></tr></thead>
                    <tbody>
                        @foreach (var s in _stock)
                        {
                            <tr>
                                <td class="mono small">@s.Item.Sku</td>
                                <td><a href="@($"stockroom/items/{s.Item.Id}")">@s.Item.Name</a> @if (s.IsLow) { <span class="badge bad">low</span> }</td>
                                <td class="muted small">@string.Join(", ", s.ByLocation.Select(l => $"{LocationName(l.Key)}: {l.Value:0.###}"))</td>
                                <td class="num"><strong>@s.Total.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)</strong> <span class="muted small">@s.Item.Unit</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <aside>
        <section class="card">
            <h2>Record movement</h2>
            <EditForm Model="_move" OnSubmit="MoveAsync" class="stack">
                <div class="btn-group">
                    @foreach (var kind in new[] { "Receive", "Consume", "Count", "Transfer" })
                    {
                        <button type="button" class="btn sm @(_move.Kind == kind ? "active" : null)" @onclick="() => _move.Kind = kind">@kind</button>
                    }
                </div>
                <label class="field"><span>Item</span>
                    <InputSelect @bind-Value="_move.ItemId">
                        <option value="0">Choose…</option>
                        @foreach (var s in _stock) { <option value="@s.Item.Id">@s.Item.Sku · @s.Item.Name</option> }
                    </InputSelect>
                </label>
                <label class="field"><span>@(_move.Kind == "Transfer" ? "From" : "Location")</span>
                    <InputSelect @bind-Value="_move.LocationId">
                        <option value="0">Choose…</option>
                        @foreach (var l in _locations) { <option value="@l.Id">@l.Name</option> }
                    </InputSelect>
                </label>
                @if (_move.Kind == "Transfer")
                {
                    <label class="field"><span>To</span>
                        <InputSelect @bind-Value="_move.ToLocationId">
                            <option value="0">Choose…</option>
                            @foreach (var l in _locations) { <option value="@l.Id">@l.Name</option> }
                        </InputSelect>
                    </label>
                }
                <label class="field"><span>@(_move.Kind == "Count" ? "Counted quantity" : "Quantity")</span><InputNumber @bind-Value="_move.Quantity" step="any" /></label>
                <label class="field"><span>Note</span><InputText @bind-Value="_move.Note" placeholder="PO #123, job, reason…" /></label>
                <button class="btn primary" disabled="@Busy">Record</button>
            </EditForm>
        </section>

        <section class="card">
            <h2>New item</h2>
            <EditForm Model="_item" OnSubmit="AddItemAsync" class="stack">
                <div class="row">
                    <label class="field grow"><span>SKU</span><InputText @bind-Value="_item.Sku" /></label>
                    <label class="field" style="width:90px"><span>Unit</span><InputText @bind-Value="_item.Unit" /></label>
                </div>
                <label class="field"><span>Name</span><InputText @bind-Value="_item.Name" /></label>
                <label class="field"><span>Alert when at or below</span><InputNumber @bind-Value="_item.LowStock" step="any" /></label>
                <button class="btn">Add item</button>
            </EditForm>
        </section>
    </aside>
</div>

@code {
    private IReadOnlyList<ItemStock> _stock = [];
    private IReadOnlyList<Location> _locations = [];
    private string? _search;
    private MoveForm _move = new();
    private ItemForm _item = new();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _locations = await Stock.ListLocationsAsync();
        _stock = await Stock.ListStockAsync(_search);
    }

    private string LocationName(int id) => _locations.FirstOrDefault(l => l.Id == id)?.Name ?? "?";

    private Task MoveAsync() => RunAsync(async () =>
    {
        AppException.ThrowIf(_move.ItemId == 0 || _move.LocationId == 0, "Choose an item and a location.");
        var user = (await CurrentUser.GetAsync()).DisplayName;
        switch (_move.Kind)
        {
            case "Receive": await Stock.ReceiveAsync(_move.ItemId, _move.LocationId, _move.Quantity, _move.Note, user); break;
            case "Consume": await Stock.ConsumeAsync(_move.ItemId, _move.LocationId, _move.Quantity, _move.Note, user); break;
            case "Count": await Stock.AdjustToAsync(_move.ItemId, _move.LocationId, _move.Quantity, _move.Note, user); break;
            default:
                AppException.ThrowIf(_move.ToLocationId == 0, "Choose where to transfer to.");
                await Stock.TransferAsync(_move.ItemId, _move.LocationId, _move.ToLocationId, _move.Quantity, _move.Note, user);
                break;
        }
        _move = new MoveForm { Kind = _move.Kind, ItemId = _move.ItemId, LocationId = _move.LocationId };
        await LoadAsync();
    }, "Recorded.");

    private Task AddItemAsync() => RunAsync(async () =>
    {
        await Stock.SaveItemAsync(null, _item.Sku, _item.Name, _item.Unit, _item.LowStock, null);
        _item = new();
        await LoadAsync();
    }, "Item added.");

    private sealed class MoveForm
    {
        public string Kind { get; set; } = "Receive";
        public int ItemId { get; set; }
        public int LocationId { get; set; }
        public int ToLocationId { get; set; }
        public decimal Quantity { get; set; }
        public string? Note { get; set; }
    }

    private sealed class ItemForm
    {
        public string Sku { get; set; } = "";
        public string Name { get; set; } = "";
        public string Unit { get; set; } = "pcs";
        public decimal? LowStock { get; set; }
    }
}
