@page "/wiki/{Id:int}"
@inherits ModulePage
@inject WikiService Wiki
@inject ICurrentUser CurrentUser
@inject NavigationManager Navigation

@if (_page is null)
{
    <Alerts Error="@Error" />
}
else
{
    <PageHeader Title="@_page.Title" Subtitle="@($"Last edited by {_page.UpdatedBy} · {Format.DateTime(_page.UpdatedUtc)}")">
        <a class="btn" href="@($"wiki/{Id}/history")">History</a>
        <a class="btn primary" href="@($"wiki/{Id}/edit")"><Icon Name="edit" /> Edit</a>
    </PageHeader>
    <Alerts Error="@Error" Success="@Success" />

    <WikiLayout Tree="_tree" ActiveId="Id">
        <section class="card">
            <nav class="small muted" style="margin-bottom:10px">
                <a href="wiki">Wiki</a>
                @foreach (var crumb in WikiService.Breadcrumbs(_tree, Id)) { <span> / </span><a href="@($"wiki/{crumb.Id}")">@crumb.Title</a> }
            </nav>
            @if (string.IsNullOrWhiteSpace(_page.Body))
            {
                <p class="muted">This page is empty. <a href="@($"wiki/{Id}/edit")">Start writing</a>.</p>
            }
            <div class="prose">@Markdown.Render(_page.Body)</div>
        </section>

        <section class="card">
            <h3>Sub-pages</h3>
            <ul class="list">
                @foreach (var child in _tree.Where(n => n.ParentId == Id)) { <li><a href="@($"wiki/{child.Id}")">@child.Title</a></li> }
            </ul>
            <EditForm Model="_child" OnSubmit="AddChildAsync" class="row" style="margin-top:8px">
                <input class="grow" placeholder="New sub-page title" @bind="_child.Title" />
                <button class="btn sm"><Icon Name="plus" Size="14" /> Add</button>
            </EditForm>
        </section>
    </WikiLayout>
}

@code {
    [Parameter] public int Id { get; set; }

    private WikiPage? _page;
    private IReadOnlyList<TreeNode> _tree = [];
    private readonly ChildForm _child = new();

    protected override Task OnParametersSetAsync() => RunAsync(async () =>
    {
        _tree = await Wiki.TreeAsync();
        _page = await Wiki.GetAsync(Id);
    });

    private Task AddChildAsync() => RunAsync(async () =>
    {
        var id = await Wiki.CreateAsync(Id, _child.Title, (await CurrentUser.GetAsync()).DisplayName);
        _child.Title = "";
        Navigation.NavigateTo($"wiki/{id}/edit");
    });

    private sealed class ChildForm
    {
        public string Title { get; set; } = "";
    }
}
