@page "/pixelsqueeze"
@inherits ModulePage
@inject PixelSqueezeService Squeeze
@inject ICurrentUser CurrentUser

<PageHeader Title="PixelSqueeze" Subtitle="Drop images in, get smaller images out. Files stay in memory for 30 minutes and are never stored.">
    @if (_results.Count > 1)
    {
        <a class="btn" href="@($"pixelsqueeze/files/zip?ids={string.Join(',', _results.Select(r => r.CompressedId.ToString("N")))}")"><Icon Name="download" /> Download all (ZIP)</a>
    }
</PageHeader>
<Alerts Error="@Error" Success="@Success" />

<section class="card">
    <div class="form-row">
        <label class="field"><span>Quality: @_quality</span><input type="range" min="10" max="100" step="5" @bind="_quality" @bind:event="oninput" /></label>
        <label class="field"><span>Output format</span>
            <select @bind="_format">
                <option value="@OutputFormat.Same">Same as input</option>
                <option value="@OutputFormat.Webp">WebP</option>
                <option value="@OutputFormat.Jpeg">JPEG</option>
                <option value="@OutputFormat.Png">PNG (lossless)</option>
            </select>
        </label>
        <label class="field narrow"><span>Max width/height</span><input type="number" min="16" max="10000" placeholder="original" @bind="_maxDimension" /></label>
    </div>

    <label class="dropzone @(Busy ? "busy" : null)">
        <InputFile OnChange="UploadAsync" multiple accept="image/jpeg,image/png,image/webp,image/gif,image/bmp" />
        <Icon Name="upload" Size="28" />
        <span>@(Busy ? $"Compressing {_progress}…" : "Click or drop images here (JPEG, PNG, WebP, GIF, BMP · up to 25 MB each)")</span>
    </label>
</section>

@if (_results.Count > 0)
{
    <section class="card">
        <div class="row between">
            <h2>Results</h2>
            <span class="muted">Saved @Format.Bytes(_results.Sum(r => r.OriginalBytes - r.CompressedBytes)) in total</span>
        </div>
        <div class="table-wrap">
            <table>
                <thead><tr><th></th><th>File</th><th class="num">Before</th><th class="num">After</th><th class="num">Saved</th><th></th></tr></thead>
                <tbody>
                    @foreach (var r in _results)
                    {
                        <tr>
                            <td><img class="thumb" src="@($"pixelsqueeze/files/{r.CompressedId:N}?inline=true")" alt="" loading="lazy" /></td>
                            <td>
                                @r.FileName <span class="muted small">@r.Width×@r.Height</span>
                                @if (r.KeptOriginal) { <span class="badge">already optimal</span> }
                            </td>
                            <td class="num">@Format.Bytes(r.OriginalBytes)</td>
                            <td class="num">@Format.Bytes(r.CompressedBytes)</td>
                            <td class="num @(r.SavedPercent > 0 ? "success-text" : null)">@r.SavedPercent.ToString("0", System.Globalization.CultureInfo.InvariantCulture)%</td>
                            <td class="actions">
                                <button class="btn sm ghost" @onclick="() => _compare = _compare == r ? null : r">Compare</button>
                                <a class="btn sm" href="@($"pixelsqueeze/files/{r.CompressedId:N}")"><Icon Name="download" Size="16" /></a>
                            </td>
                        </tr>
                        @if (_compare == r)
                        {
                            <tr>
                                <td colspan="6">
                                    <div class="grid-2">
                                        <figure class="compare"><img src="@($"pixelsqueeze/files/{r.OriginalId:N}?inline=true")" alt="Original" /><figcaption>Original · @Format.Bytes(r.OriginalBytes)</figcaption></figure>
                                        <figure class="compare"><img src="@($"pixelsqueeze/files/{r.CompressedId:N}?inline=true")" alt="Compressed" /><figcaption>Compressed · @Format.Bytes(r.CompressedBytes)</figcaption></figure>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
}

@code {
    private const int MaxFiles = 20;

    private readonly List<CompressResult> _results = [];
    private int _quality = 75;
    private OutputFormat _format = OutputFormat.Same;
    private int? _maxDimension;
    private string _progress = "";
    private CompressResult? _compare;

    private Task UploadAsync(InputFileChangeEventArgs e) => RunAsync(async () =>
    {
        var owner = (await CurrentUser.GetAsync()).Id;
        var files = e.GetMultipleFiles(MaxFiles);
        var failures = new List<string>();
        for (var i = 0; i < files.Count; i++)
        {
            _progress = $"{i + 1}/{files.Count}";
            StateHasChanged();
            try
            {
                await using var stream = files[i].OpenReadStream(ImageCompressor.MaxInputBytes);
                _results.Insert(0, await Squeeze.CompressAsync(stream, files[i].Name, owner, _quality, _format, _maxDimension));
            }
            catch (Exception ex) when (ex is AppException or IOException)
            {
                failures.Add($"{files[i].Name}: {ex.Message}");
            }
        }
        if (failures.Count > 0)
            throw new AppException(string.Join(" · ", failures));
    });
}
